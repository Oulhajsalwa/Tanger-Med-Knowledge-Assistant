# ============================================================================
# Tanger Med Knowledge Assistant - Configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file (it is already in .gitignore).
# ============================================================================

# --- OpenRouter credentials -------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Base URL of the OpenRouter API (OpenAI-compatible). Rarely needs changing.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chat / generation model used for the RAG answer generation step.
OPENROUTER_MODEL=openai/gpt-4o

# Embedding model used to vectorize document chunks and queries.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large

# Embedding vector dimension for the model above (must match the model).
OPENROUTER_EMBEDDING_DIM=3072

# Optional headers OpenRouter uses for attribution / rate-limit dashboards.
OPENROUTER_SITE_URL=https://github.com/your-org/tanger-med-rag
OPENROUTER_APP_NAME=Tanger Med Knowledge Assistant

# --- Embeddings provider (optional override) ---------------------------------
# By default embeddings go through OPENROUTER_BASE_URL / OPENROUTER_API_KEY.
# If your router does not serve an /embeddings endpoint, point embeddings at
# any OpenAI-compatible provider here - no code change required.
# Run `python scripts/check_openrouter.py` to find out which one to use.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---------------------------------------------------------------
# Number of candidates fetched from EACH retriever (semantic + BM25) before fusion.
TOP_K=8
# Number of chunks finally kept in the LLM context after fusion/rerank.
FINAL_CONTEXT_K=5
# Weight given to semantic similarity vs lexical (BM25) score during fusion.
# score = RETRIEVAL_ALPHA * semantic_score + (1 - RETRIEVAL_ALPHA) * lexical_score
RETRIEVAL_ALPHA=0.7

# --- Abstention (anti-hallucination) -----------------------------------------
# Two complementary guards decide whether the system answers or abstains.
# 1) Minimum FUSED relevance score (0-1) required to answer at all.
RELEVANCE_THRESHOLD=0.20
# 2) Minimum RAW COSINE similarity the best passage must reach for the question
#    to be considered on-topic. This is the guard that enables *thematic*
#    abstention: BM25 alone cannot tell an off-topic question from a relevant
#    one on a corpus saturated with generic business vocabulary.
#    Both values are corpus- and embedding-model dependent: re-calibrate them
#    with `python evaluation/evaluate.py` after changing the corpus or model.
MIN_SEMANTIC_SCORE=0.25
# Saturation constant of the BM25 normalization raw/(raw+k), calibrated on this
# corpus (a strong lexical match scores raw ~24 -> ~0.6).
BM25_SATURATION_K=15.0

# --- Storage -----------------------------------------------------------------
DATA_DIR=data
VECTORSTORE_DIR=vectorstore
COLLECTION_NAME=tanger_med_reports

# --- Reliability ---------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3

# --- Observability -------------------------------------------------------------
LOG_LEVEL=INFO
