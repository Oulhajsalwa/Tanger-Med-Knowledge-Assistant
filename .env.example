

# --- OpenRouter credentials -------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chat / generation model used for the RAG answer generation step.
OPENROUTER_MODEL=openai/gpt-4o

# Embedding model used to vectorize document chunks and queries.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large

# Embedding vector dimension for the model above (must match the model).
OPENROUTER_EMBEDDING_DIM=3072

# Optional headers OpenRouter uses for attribution / rate-limit dashboards.
OPENROUTER_SITE_URL=https://github.com/your-org/tanger-med-rag
OPENROUTER_APP_NAME=Tanger Med Knowledge Assistant


EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---------------------------------------------------------------

TOP_K=8

FINAL_CONTEXT_K=5

# score = RETRIEVAL_ALPHA * semantic_score + (1 - RETRIEVAL_ALPHA) * lexical_score
RETRIEVAL_ALPHA=0.7



# --- Storage -----------------------------------------------------------------
DATA_DIR=data
VECTORSTORE_DIR=vectorstore
COLLECTION_NAME=tanger_med_reports

# --- Reliability ---------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3

# --- Observability -------------------------------------------------------------
LOG_LEVEL=INFO
